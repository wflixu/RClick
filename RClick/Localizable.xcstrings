    "Authorize folders to let RClick create, delete, and manage files in them." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Authorize folders to let RClick create, delete, and manage files in them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriza carpetas para que RClick pueda crear, eliminar y administrar archivos en ellas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez des dossiers pour permettre à RClick d’y créer, supprimer et gérer des fichiers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダを認証して、RClick がファイルの作成、削除、管理を行えるようにします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授权文件夹，让 RClick 可以在其中创建、删除和管理文件。"
          }
        }
      }
    },
