    "RClick could not access its shared App Group container, so it cannot read its settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick could not access its shared App Group container, so it cannot read its settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick no pudo acceder a su contenedor compartido de App Group, por lo que no puede leer su configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick n'a pas pu accéder à son conteneur App Group partagé et ne peut donc pas lire sa configuration."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick は共有 App Group コンテナにアクセスできないため、設定を読み込めません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick 无法访问共享的 App Group 容器，因此读不到配置数据。"
          }
        }
      }
    },
    "RClick is a right-click menu extension that allows you to add applications for opening folders and includes some common actions." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick is a right-click menu extension that allows you to add applications for opening folders and includes some common actions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick es una extensión del menú contextual que te permite agregar aplicaciones para abrir carpetas e incluye algunas acciones frecuentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick est une extension du menu clic droit qui vous permet d’ajouter des applications pour ouvrir des dossiers et inclut quelques actions courantes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick はフォルダを開くアプリを追加できる右クリックメニュー拡張で、いくつかの便利な操作も含まれています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick 是一个右键菜单扩展，可以添加打开文件夹的应用，并提供一些常用操作。"
          }
        }
      }
    },
    "RClick is installed from the Mac App Store. Please update it from the App Store." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick is installed from the Mac App Store. Please update it from the App Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick se instaló desde la Mac App Store. Actualízalo desde la App Store."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick a été installé depuis le Mac App Store. Veuillez le mettre à jour depuis l’App Store."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick は Mac App Store からインストールされています。App Store からアップデートしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick 是从 Mac App Store 安装的。请从 App Store 更新。"
          }
        }
      }
    },
    "RClick needs \"%@\" permission to rename a newly created file automatically. Enable it for the RClick app in System Settings > %@." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick needs \"%@\" permission to rename a newly created file automatically. Enable it for the RClick app in System Settings > %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick necesita el permiso «%@» para cambiar el nombre de un archivo recién creado automáticamente. Actívalo para la app RClick en Ajustes del Sistema > %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick a besoin de l’autorisation « %@ » pour renommer automatiquement un fichier nouvellement créé. Activez-la pour l’app RClick dans Réglages Système > %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick が新規作成したファイルの名前を自動で変更するには「%@」権限が必要です。システム設定 > %@ で RClick アプリに許可してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick 需要「%@」权限，才能在新建文件后自动重命名。请在系统设置 > %@ 中为 RClick 主程序开启该权限。"
          }
        }
      }
    },
    "RClick needs access to this folder to delete, create, and modify files. Choose this folder or a broader parent folder to cover its subfolders. You can manage these grants in Settings → Folder Permissions." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick needs access to this folder to delete, create, and modify files. Choose this folder or a broader parent folder to cover its subfolders. You can manage these grants in Settings → Folder Permissions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick necesita acceso a esta carpeta para eliminar, crear y modificar archivos. Elige esta carpeta o una carpeta principal más amplia para cubrir también sus subcarpetas. Puedes administrar estos permisos en Ajustes → Permisos de carpetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick a besoin d’accéder à ce dossier pour supprimer, créer et modifier des fichiers. Choisissez ce dossier ou un dossier parent plus large pour couvrir ses sous-dossiers. Vous pouvez gérer ces autorisations dans Réglages → Autorisations de dossiers."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick がこのフォルダ内のファイルを削除・作成・変更するにはアクセス権が必要です。このフォルダ、またはより上位のフォルダを選択するとサブフォルダもカバーされます。許可は設定 → フォルダ権限で管理できます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick 需要访问此文件夹以删除、创建和修改文件。请选择此文件夹或更上层的父文件夹以覆盖其子文件夹。可在 设置 → 文件夹权限 中管理这些授权。"
          }
        }
      }
    },
    "RClick needs permission to install the update into your Applications folder." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick needs permission to install the update into your Applications folder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick necesita permiso para instalar la actualización en tu carpeta Aplicaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick a besoin d’une autorisation pour installer la mise à jour dans votre dossier Applications."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick がアップデートをアプリケーションフォルダにインストールするには権限が必要です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RClick 需要权限以将更新安装到您的“应用程序”文件夹中。"
          }
        }
      }
    },
