    "A mouse-first image viewer with animated GIF, APNG and WebP playback." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A mouse-first image viewer with animated GIF, APNG and WebP playback."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un visor de imágenes centrado en el ratón, con reproducción de GIF, APNG y WebP animados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une visionneuse d'images centrée sur la souris, avec lecture des GIF, APNG et WebP animés."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カーソル中心にズームできる画像ビューア。GIF、APNG、WebP のアニメーション再生に対応。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以鼠标为中心的图片查看器，支持 GIF、APNG 和 WebP 动图播放。"
          }
        }
      }
    },
