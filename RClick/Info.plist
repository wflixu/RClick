<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Finder draws this symbol on the sidebar entries of every root the Finder Sync
	  extension observes (#158). Without it, the sidebar shows RClick's app icon on
	  every external disk and mounted disk image instead of a drive icon.
	  See specs/external-volumes-observation.md.
	-->
	<key>CFBundleIcons</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleSymbolName</key>
			<string>externaldrive</string>
		</dict>
	</dict>
</dict>
</plist>
