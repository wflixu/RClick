    "RClick is not running": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RClick is not running"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RClick no está en ejecución"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RClick n’est pas lancé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RClick が実行されていません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RClick 未运行"
          }
        }
      }
    },
    "Restart RClick to restore the menu": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restart RClick to restore the menu"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinicia RClick para restaurar el menú"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relancez RClick pour rétablir le menu"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RClick を再起動するとメニューが復元されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新启动 RClick 后菜单将恢复"
          }
        }
      }
    },
    "This action requires RClick to be running. Please launch RClick and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This action requires RClick to be running. Please launch RClick and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta acción requiere que RClick esté en ejecución. Inicia RClick e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action nécessite que RClick soit lancé. Veuillez lancer RClick et réessayer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作には RClick の実行が必要です。RClick を起動してもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作需要 RClick 正在运行。请启动 RClick 后重试。"
          }
        }
      }
    },
    "RClick did not respond": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "RClick did not respond"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "RClick no respondió"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RClick ne répond pas"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "RClick が応答しませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "RClick 无响应"
          }
        }
      }
    },
    "The operation may not have been executed. Please check that RClick is running.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The operation may not have been executed. Please check that RClick is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que la operación no se haya ejecutado. Comprueba que RClick esté en ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opération n’a peut-être pas été exécutée. Vérifiez que RClick est lancé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作が実行されていない可能性があります。RClick が実行されているか確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作可能未执行。请确认 RClick 正在运行。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
